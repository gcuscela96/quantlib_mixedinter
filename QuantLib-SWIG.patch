+// linear-in-(r*t) up to a frontier pillar, natural cubic spline (fitted
+// only from that pillar onward) after it -- see
+// ql/math/interpolations/frontierlinearrtcubicinterpolation.hpp
+export_piecewise_curve(PiecewiseFrontierMixedZero,ZeroYield,FrontierLinearRtCubicNatural);
+export_piecewise_curve(PiecewiseFrontierMixedRtZero,ZeroYield,FrontierLinearRtCubicNaturalRt);
+
+// forwarding curve bootstrapped as an additive zero-rate spread on top of a
+// backbone (discounting) curve, e.g. Euribor = ESTR (interpolated) + spread,
+// with the spread itself using the frontier linear/cubic-in-(s*t) mixed
+// scheme above -- see
+// ql/termstructures/yield/piecewisefrontiermixedrtzerospreaded.hpp
+%{
+using QuantLib::PiecewiseFrontierMixedRtZeroSpreaded;
+%}
+
+%shared_ptr(PiecewiseFrontierMixedRtZeroSpreaded);
+class PiecewiseFrontierMixedRtZeroSpreaded : public YieldTermStructure {
+  public:
+    #if !defined(SWIGJAVA) && !defined(SWIGCSHARP)
+    %feature("kwargs") PiecewiseFrontierMixedRtZeroSpreaded;
+    #endif
+    %extend {
+        PiecewiseFrontierMixedRtZeroSpreaded(
+            const Date& referenceDate,
+            const std::vector<ext::shared_ptr<RateHelper> >& instruments,
+            const DayCounter& dayCounter,
+            const Handle<YieldTermStructure>& backbone,
+            Time frontierTime,
+            const std::vector<Handle<Quote> >& jumps = std::vector<Handle<Quote> >(),
+            const std::vector<Date>& jumpDates = std::vector<Date>(),
+            const _IterativeBootstrap& b = _IterativeBootstrap()) {
+            return new PiecewiseFrontierMixedRtZeroSpreaded(
+                referenceDate, instruments, dayCounter, backbone, frontierTime,
+                jumps, jumpDates,
+                make_bootstrap<PiecewiseFrontierMixedRtZeroSpreaded>(b));
+        }
+        PiecewiseFrontierMixedRtZeroSpreaded(
+            Integer settlementDays, const Calendar& calendar,
+            const std::vector<ext::shared_ptr<RateHelper> >& instruments,
+            const DayCounter& dayCounter,
+            const Handle<YieldTermStructure>& backbone,
+            Time frontierTime,
+            const std::vector<Handle<Quote> >& jumps = std::vector<Handle<Quote> >(),
+            const std::vector<Date>& jumpDates = std::vector<Date>(),
+            const _IterativeBootstrap& b = _IterativeBootstrap()) {
+            return new PiecewiseFrontierMixedRtZeroSpreaded(
+                settlementDays, calendar, instruments, dayCounter, backbone, frontierTime,
+                jumps, jumpDates,
+                make_bootstrap<PiecewiseFrontierMixedRtZeroSpreaded>(b));
+        }
+    }
+
+    const Handle<YieldTermStructure>& backboneCurve() const;
+
+    const std::vector<Date>& dates() const;
+    const std::vector<Time>& times() const;
+    const std::vector<Real>& data() const;
+    #if !defined(SWIGR)
+    std::vector<std::pair<Date,Real> > nodes() const;
+    #endif
+
+    void recalculate();
+    void freeze();
+    void unfreeze();
+};
 
 

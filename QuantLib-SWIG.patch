 make_mixed_linear_cubic(LogMixedLinearCubic);
 
+%define make_frontier_linear_rt_cubic(T)
+%{
+class T : public QuantLib::T {
+  public:
+    // Defaults for all constructor arguments, for the same reason as
+    // make_mixed_linear_cubic above: generic curve wrappers assume every
+    // interpolator has a default constructor.
+    T(Time frontierTime = 0.0)
+    : QuantLib::T(frontierTime) {}
+};
+%}
+
+struct T {
+    T(Time frontierTime = 0.0);
+};
+%enddef
+
+%define make_frontier_linear_rt_cubic_full(T)
+%{
+class T : public QuantLib::T {
+  public:
+    T(Time frontierTime = 0.0,
+      CubicInterpolation::DerivativeApprox da = CubicInterpolation::Spline,
+      bool monotonic = false,
+      CubicInterpolation::BoundaryCondition leftCondition
+          = CubicInterpolation::SecondDerivative,
+      Real leftConditionValue = 0.0,
+      CubicInterpolation::BoundaryCondition rightCondition
+          = CubicInterpolation::SecondDerivative,
+      Real rightConditionValue = 0.0,
+      bool cubicInRt = false)
+    : QuantLib::T(frontierTime, da, monotonic, leftCondition, leftConditionValue,
+                  rightCondition, rightConditionValue, cubicInRt) {}
+};
+%}
+
+struct T {
+    #if !defined(SWIGJAVA) && !defined(SWIGCSHARP)
+    %feature("kwargs") T;
+    #endif
+    T(Time frontierTime = 0.0,
+      CubicInterpolation::DerivativeApprox da = CubicInterpolation::Spline,
+      bool monotonic = false,
+      CubicInterpolation::BoundaryCondition leftCondition
+          = CubicInterpolation::SecondDerivative,
+      doubleOrNull leftConditionValue = 0.0,
+      CubicInterpolation::BoundaryCondition rightCondition
+          = CubicInterpolation::SecondDerivative,
+      doubleOrNull rightConditionValue = 0.0,
+      bool cubicInRt = false);
+};
+%enddef
+
+// linear-in-(r*t) before the frontier time, natural cubic spline (fitted
+// only from the frontier pillar onward) after it -- see
+// ql/math/interpolations/frontierlinearrtcubicinterpolation.hpp
+// FrontierLinearRtCubicNatural: cubic segment fitted directly on y (e.g. the zero rate)
+make_frontier_linear_rt_cubic(FrontierLinearRtCubicNatural);
+// FrontierLinearRtCubicNaturalRt: cubic segment fitted on y*x (r*t) instead, like the
+// linear segment, and divided back by x when evaluated
+make_frontier_linear_rt_cubic(FrontierLinearRtCubicNaturalRt);
+// same as FrontierLinearRtCubicNatural, but with full control over the cubic segment's
+// DerivativeApprox, monotonicity, boundary conditions, and whether it is fitted on y or on y*x
+make_frontier_linear_rt_cubic_full(FrontierLinearRtCubic);
+

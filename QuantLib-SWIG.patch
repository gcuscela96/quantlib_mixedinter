+%shared_ptr(OvernightIborBasisSwapRateHelperCustomPillar)
+class OvernightIborBasisSwapRateHelperCustomPillar : public RateHelper {
+    #if !defined(SWIGJAVA) && !defined(SWIGCSHARP)
+    %feature("kwargs") OvernightIborBasisSwapRateHelperCustomPillar;
+    #endif
+  public:
+    // same as OvernightIborBasisSwapRateHelper, but the implied ibor rate is
+    // placed, on the curve being bootstrapped, at customPillarDate instead
+    // of at the instrument's own maturity (spot + tenor); the underlying
+    // basis swap itself still runs over its real spot-to-spot+tenor
+    // schedule -- see ql/termstructures/yield/ratehelperwithcustompillar.hpp
+    OvernightIborBasisSwapRateHelperCustomPillar(
+                                     const Date& customPillarDate,
+                                     const Handle<Quote>& basis,
+                                     const Period& tenor,
+                                     Natural settlementDays,
+                                     Calendar calendar,
+                                     BusinessDayConvention convention,
+                                     bool endOfMonth,
+                                     const ext::shared_ptr<OvernightIndex>& baseIndex,
+                                     const ext::shared_ptr<IborIndex>& otherIndex,
+                                     Handle<YieldTermStructure> discountHandle = {},
+                                     bool bootstrapBaseCurve = false,
+                                     Integer paymentLag = 0,
+                                     std::optional<Frequency> overnightPaymentFrequency = std::nullopt,
+                                     std::optional<bool> useIndexedCoupons = std::nullopt,
+                                     DateGeneration::Rule rule = DateGeneration::Backward,
+                                     RateAveraging::Type averagingMethod = RateAveraging::Compound,
+                                     bool telescopicValueDates = false,
+                                     bool basisOnIborLeg = false);
+    ext::shared_ptr<Swap> swap();
+};
+
+%shared_ptr(OvernightIborBasisSwapRateHelperForwardStarting)
+class OvernightIborBasisSwapRateHelperForwardStarting : public RateHelper {
+    #if !defined(SWIGJAVA) && !defined(SWIGCSHARP)
+    %feature("kwargs") OvernightIborBasisSwapRateHelperForwardStarting;
+    #endif
+  public:
+    // forward-starting overnight-vs-ibor basis swap: startDate and endDate
+    // are explicit, fixed dates (e.g. two IMM/ECB dates) rather than being
+    // derived from the evaluation date via settlementDays + tenor; the
+    // bootstrap pillar defaults to endDate, or to customPillarDate if given.
+    // customPaymentDate additionally supports an "early payment" stub: the
+    // overnight/ibor legs still accrue/fix over their real startDate-to-
+    // endDate period, but both coupons are paid on customPaymentDate
+    // instead (only supported for a single-period/stub schedule; and, when
+    // customPillarDate is not given, the pillar then defaults to
+    // customPaymentDate instead of endDate). overnightDayCounter/
+    // iborDayCounter let each leg use an accrual day counter different
+    // from its index's native one. overnightFlatRatePayment/
+    // iborFlatRatePayment switch a leg's cash flow to amount = rate() *
+    // nominal() with NO day-count accrual-period scaling at all.
+    // -- see ql/termstructures/yield/forwardstartingbasisswaphelper.hpp
+    OvernightIborBasisSwapRateHelperForwardStarting(
+                                     const Date& startDate,
+                                     const Date& endDate,
+                                     const Handle<Quote>& basis,
+                                     Calendar calendar,
+                                     BusinessDayConvention convention,
+                                     bool endOfMonth,
+                                     const ext::shared_ptr<OvernightIndex>& baseIndex,
+                                     const ext::shared_ptr<IborIndex>& otherIndex,
+                                     Handle<YieldTermStructure> discountHandle = {},
+                                     bool bootstrapBaseCurve = false,
+                                     Integer paymentLag = 0,
+                                     std::optional<Frequency> overnightPaymentFrequency = std::nullopt,
+                                     std::optional<bool> useIndexedCoupons = std::nullopt,
+                                     DateGeneration::Rule rule = DateGeneration::Backward,
+                                     RateAveraging::Type averagingMethod = RateAveraging::Compound,
+                                     bool telescopicValueDates = false,
+                                     bool basisOnIborLeg = false,
+                                     const Date& customPillarDate = Date(),
+                                     const Date& customPaymentDate = Date(),
+                                     DayCounter overnightDayCounter = DayCounter(),
+                                     DayCounter iborDayCounter = DayCounter(),
+                                     bool overnightFlatRatePayment = false,
+                                     bool iborFlatRatePayment = false);
+    ext::shared_ptr<Swap> swap();
+};

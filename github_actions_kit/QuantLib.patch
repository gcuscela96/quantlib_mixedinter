new file mode 100644
index 0000000..0380809
--- /dev/null
+++ b/Examples/FrontierMixedCurve/frontier_mixed_curve_example.cpp
@@ -0,0 +1,82 @@
+/* Example: bootstrapping a zero curve with a "frontier" interpolation
+   scheme -- linear in r*t up to a chosen pillar, natural cubic spline
+   (fitted only from that pillar onward) after it.
+
+   Build (once the library is built and installed, or by pointing the
+   include/lib paths at this checkout), e.g.:
+
+       g++ -std=c++17 frontier_mixed_curve_example.cpp -lQuantLib -o frontier_example
+
+   or, against this checkout without installing:
+
+       g++ -std=c++17 -I .. -I ../build frontier_mixed_curve_example.cpp \
+           -L ../build/ql -lQuantLib -o frontier_example
+*/
+
+#include <ql/qldefines.hpp>
+#include <ql/math/interpolations/frontierlinearrtcubicinterpolation.hpp>
+#include <ql/termstructures/yield/piecewiseyieldcurve.hpp>
+#include <ql/termstructures/yield/ratehelpers.hpp>
+#include <ql/time/calendars/target.hpp>
+#include <ql/time/daycounters/actual365fixed.hpp>
+#include <ql/currencies/europe.hpp>
+#include <ql/indexes/ibor/euribor.hpp>
+#include <iostream>
+
+using namespace QuantLib;
+
+int main() {
+    Calendar calendar = TARGET();
+    Date today(26, August, 2026);
+    Settings::instance().evaluationDate() = today;
+    DayCounter dc = Actual365Fixed();
+
+    // A handful of fictitious deposit/swap-like quotes, purely to
+    // demonstrate the shape of the interpolation -- NOT market data.
+    std::vector<ext::shared_ptr<RateHelper>> helpers;
+    struct Q { Period tenor; Rate rate; };
+    std::vector<Q> quotes = {
+        {1 * Months,  0.0300},
+        {3 * Months,  0.0310},
+        {6 * Months,  0.0320},
+        {1 * Years,   0.0330},
+        {2 * Years,   0.0340},   // <-- this will be our frontier pillar
+        {3 * Years,   0.0338},
+        {5 * Years,   0.0332},
+        {7 * Years,   0.0330},
+        {10 * Years,  0.0335},
+        {15 * Years,  0.0345},
+        {20 * Years,  0.0350},
+        {30 * Years,  0.0348},
+    };
+    auto euribor6m = ext::make_shared<Euribor>(6 * Months);
+    for (const auto& q : quotes) {
+        helpers.push_back(ext::make_shared<DepositRateHelper>(
+            Handle<Quote>(ext::make_shared<SimpleQuote>(q.rate)),
+            q.tenor, 2, calendar, ModifiedFollowing, false, dc));
+    }
+
+    // frontier = 2Y pillar, converted to the curve's own time metric
+    Date frontierDate = calendar.advance(today, 2 * Years);
+    Time frontierTime = dc.yearFraction(today, frontierDate);
+
+    // natural cubic spline after the frontier (non-monotonic, SecondDerivative=0
+    // at both ends of the spline sub-range)
+    FrontierLinearRtCubicNatural interpolator(frontierTime);
+
+    typedef PiecewiseYieldCurve<ZeroYield, FrontierLinearRtCubicNatural> Curve;
+    Curve curve(today, helpers, dc, interpolator);
+    curve.enableExtrapolation();
+
+    std::cout << "date        t         zero rate     r*t\n";
+    for (Size m = 0; m <= 360; m += 6) {
+        Date d = calendar.advance(today, m * Months);
+        Time t = dc.yearFraction(today, d);
+        if (t == 0.0) continue;
+        Rate r = curve.zeroRate(d, dc, Continuous).rate();
+        std::cout << d << "  " << t << "  " << r << "  " << r * t
+                   << (std::abs(t - frontierTime) < 1e-6 ? "   <-- frontier" : "")
+                   << "\n";
+    }
+    return 0;
+}

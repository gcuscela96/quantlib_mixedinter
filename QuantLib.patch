diff --git a/ql/termstructures/yield/forwardstartingbasisswaphelper.hpp b/ql/termstructures/yield/forwardstartingbasisswaphelper.hpp
new file mode 100644
index 0000000..24145f0
--- /dev/null
+++ b/ql/termstructures/yield/forwardstartingbasisswaphelper.hpp
@@ -0,0 +1,211 @@
+/* -*- mode: c++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+
+/*
+ This file is part of a fork of QuantLib intended to add support for a
+ forward-starting overnight-vs-ibor basis swap rate helper, whose start
+ and end dates are explicit, fixed dates (e.g. two IMM/ECB dates) rather
+ than being derived from the evaluation date via settlementDays + tenor.
+
+ QuantLib is free software: you can redistribute it and/or modify it
+ under the terms of the QuantLib license.  You should have received a
+ copy of the license along with this program; if not, please email
+ <quantlib-dev@lists.sf.net>. The license is also available online at
+ <https://www.quantlib.org/license.shtml>.
+
+ This program is distributed in the hope that it will be useful, but WITHOUT
+ ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+ FOR A PARTICULAR PURPOSE.  See the license for more details.
+*/
+
+/*! \file forwardstartingbasisswaphelper.hpp
+    \brief overnight-vs-ibor basis swap rate helper with explicit,
+           fixed forward start and end dates (e.g. two IMM/ECB dates)
+*/
+
+#ifndef quantlib_forward_starting_basis_swap_helper_hpp
+#define quantlib_forward_starting_basis_swap_helper_hpp
+
+#include <ql/cashflows/iborcoupon.hpp>
+#include <ql/cashflows/overnightindexedcoupon.hpp>
+#include <ql/experimental/termstructures/basisswapratehelpers.hpp>
+#include <ql/pricingengines/swap/discountingswapengine.hpp>
+#include <ql/utilities/null_deleter.hpp>
+#include <utility>
+
+namespace QuantLib {
+
+    //! Forward-starting overnight-vs-ibor basis swap rate helper
+    /*! Same instrument and same bootstrap logic as
+        QuantLib::OvernightIborBasisSwapRateHelper (the swap is assumed to
+        pay overnight + basis and receive ibor; see that class's
+        documentation for the meaning of bootstrapBaseCurve, the
+        overnight payment frequency, averaging method, etc.), but the
+        swap's start and end dates are two *explicit, fixed* dates
+        (typically two IMM/ECB dates, three months apart) instead of
+        being computed from the evaluation date via settlementDays and a
+        tenor.
+
+        Because startDate/endDate do not depend on the evaluation date,
+        this helper does *not* derive from RelativeDateRateHelper: its
+        schedule is built once, in the constructor, and never needs to
+        be rebuilt when the evaluation date changes (this is exactly the
+        "fixed-effective-date constructor" pattern QuantLib documents in
+        ql/termstructures/bootstraphelper.hpp as the way to avoid
+        unnecessary curve re-bootstraps on every evaluation date tick).
+
+        By default the bootstrap pillar is placed at \c endDate (the
+        natural choice for a forward-starting instrument between two
+        custom dates); pass an explicit \c customPillarDate to override
+        it, using the same mechanism as
+        OvernightIborBasisSwapRateHelperCustomPillar (see
+        ratehelperwithcustompillar.hpp).
+    */
+    class OvernightIborBasisSwapRateHelperForwardStarting : public RateHelper {
+      public:
+        OvernightIborBasisSwapRateHelperForwardStarting(
+                const Date& startDate,
+                const Date& endDate,
+                const Handle<Quote>& basis,
+                Calendar calendar,
+                BusinessDayConvention convention,
+                bool endOfMonth,
+                const ext::shared_ptr<OvernightIndex>& baseIndex,
+                const ext::shared_ptr<IborIndex>& otherIndex,
+                Handle<YieldTermStructure> discountHandle = Handle<YieldTermStructure>(),
+                bool bootstrapBaseCurve = false,
+                Integer paymentLag = 0,
+                std::optional<Frequency> overnightPaymentFrequency = std::nullopt,
+                std::optional<bool> useIndexedCoupons = std::nullopt,
+                DateGeneration::Rule rule = DateGeneration::Backward,
+                RateAveraging::Type averagingMethod = RateAveraging::Compound,
+                bool telescopicValueDates = false,
+                bool basisOnIborLeg = false,
+                const Date& customPillarDate = Date())
+        : RateHelper(basis), startDate_(startDate), endDate_(endDate),
+          calendar_(std::move(calendar)), convention_(convention), endOfMonth_(endOfMonth),
+          discountHandle_(std::move(discountHandle)), bootstrapBaseCurve_(bootstrapBaseCurve),
+          paymentLag_(paymentLag), basisOnIborLeg_(basisOnIborLeg) {
+
+            QL_REQUIRE(baseIndex, "null base overnight index");
+            QL_REQUIRE(otherIndex, "null other ibor index");
+            QL_REQUIRE(endDate > startDate, "endDate (" << endDate <<
+                       ") must be later than startDate (" << startDate << ")");
+
+            // clone the index whose forecast curve we are bootstrapping, so
+            // that it observes the curve being built rather than any
+            // pre-existing forecast curve attached to the index passed in
+            if (bootstrapBaseCurve_) {
+                baseIndex_ = ext::dynamic_pointer_cast<OvernightIndex>(
+                    baseIndex->clone(termStructureHandle_));
+                baseIndex_->unregisterWith(termStructureHandle_);
+                otherIndex_ = otherIndex;
+            } else {
+                baseIndex_ = baseIndex;
+                otherIndex_ = otherIndex->clone(termStructureHandle_);
+                otherIndex_->unregisterWith(termStructureHandle_);
+            }
+
+            registerWith(baseIndex_);
+            registerWith(otherIndex_);
+            registerWith(discountHandle_);
+
+            earliestDate_ = startDate_;
+
+            Period overnightTenor = overnightPaymentFrequency
+                ? Period(*overnightPaymentFrequency) : otherIndex_->tenor();
+            Schedule overnightSchedule =
+                MakeSchedule().from(startDate_).to(endDate_)
+                .withTenor(overnightTenor)
+                .withCalendar(calendar_)
+                .withConvention(convention_)
+                .endOfMonth(endOfMonth_)
+                .withRule(rule);
+
+            Leg baseLeg = OvernightLeg(overnightSchedule, baseIndex_)
+                .withNotionals(100.0)
+                .withPaymentLag(paymentLag_)
+                .withTelescopicValueDates(
+                    telescopicValueDates && averagingMethod == RateAveraging::Compound)
+                .withAveragingMethod(averagingMethod);
+            auto lastBaseCoupon =
+                ext::dynamic_pointer_cast<OvernightIndexedCoupon>(baseLeg.back());
+
+            Schedule iborSchedule =
+                MakeSchedule().from(startDate_).to(endDate_)
+                .withTenor(otherIndex_->tenor())
+                .withCalendar(calendar_)
+                .withConvention(convention_)
+                .endOfMonth(endOfMonth_)
+                .withRule(rule);
+
+            Leg otherLeg = IborLeg(iborSchedule, otherIndex_)
+                .withNotionals(100.0)
+                .withPaymentLag(paymentLag_)
+                .withIndexedCoupons(useIndexedCoupons);
+            auto lastOtherCoupon = ext::dynamic_pointer_cast<IborCoupon>(otherLeg.back());
+
+            maturityDate_ = std::max(overnightSchedule.endDate(), iborSchedule.endDate());
+
+            Date lastPaymentDate = std::max(baseLeg.back()->date(), otherLeg.back()->date());
+            Date lastBaseFixingEndDate = baseIndex_->maturityDate(
+                baseIndex_->valueDate(lastBaseCoupon->fixingDate()));
+
+            latestRelevantDate_ = std::max({maturityDate_, lastPaymentDate,
+                                            lastBaseFixingEndDate,
+                                            lastOtherCoupon->fixingEndDate()});
+            pillarDate_ = (customPillarDate != Date()) ? customPillarDate : endDate_;
+
+            swap_ = ext::make_shared<Swap>(baseLeg, otherLeg);
+            swap_->setPricingEngine(
+                ext::make_shared<DiscountingSwapEngine>(discountRelinkableHandle_));
+        }
+
+        Real impliedQuote() const override {
+            swap_->deepUpdate();
+            Size leg = basisOnIborLeg_ ? 1 : 0;
+            return - (swap_->NPV() / swap_->legBPS(leg)) * 1.0e-4;
+        }
+
+        void accept(AcyclicVisitor& v) override {
+            auto* v1 = dynamic_cast<Visitor<OvernightIborBasisSwapRateHelperForwardStarting>*>(&v);
+            if (v1 != nullptr)
+                v1->visit(*this);
+            else
+                RateHelper::accept(v);
+        }
+
+        ext::shared_ptr<Swap> swap() const { return swap_; }
+
+      private:
+        void setTermStructure(YieldTermStructure* t) override {
+            bool observer = false;
+            ext::shared_ptr<YieldTermStructure> temp(t, null_deleter());
+            termStructureHandle_.linkTo(temp, observer);
+
+            if (discountHandle_.empty())
+                discountRelinkableHandle_.linkTo(temp, observer);
+            else
+                discountRelinkableHandle_.linkTo(*discountHandle_, observer);
+
+            RateHelper::setTermStructure(t);
+        }
+
+        Date startDate_, endDate_;
+        Calendar calendar_;
+        BusinessDayConvention convention_;
+        bool endOfMonth_;
+        ext::shared_ptr<OvernightIndex> baseIndex_;
+        ext::shared_ptr<IborIndex> otherIndex_;
+        Handle<YieldTermStructure> discountHandle_;
+        bool bootstrapBaseCurve_;
+        Integer paymentLag_;
+        bool basisOnIborLeg_;
+
+        ext::shared_ptr<Swap> swap_;
+        RelinkableHandle<YieldTermStructure> termStructureHandle_;
+        RelinkableHandle<YieldTermStructure> discountRelinkableHandle_;
+    };
+
+}
+
+#endif
diff --git a/ql/termstructures/yield/ratehelperwithcustompillar.hpp b/ql/termstructures/yield/ratehelperwithcustompillar.hpp
new file mode 100644
index 0000000..b506d64
--- /dev/null
+++ b/ql/termstructures/yield/ratehelperwithcustompillar.hpp
@@ -0,0 +1,112 @@
+/* -*- mode: c++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+
+/*
+ This file is part of a fork of QuantLib intended to add support for
+ placing a RateHelper's bootstrap pillar on a date that differs from the
+ helper's own instrument schedule/maturity.
+
+ QuantLib is free software: you can redistribute it and/or modify it
+ under the terms of the QuantLib license.  You should have received a
+ copy of the license along with this program; if not, please email
+ <quantlib-dev@lists.sf.net>. The license is also available online at
+ <https://www.quantlib.org/license.shtml>.
+
+ This program is distributed in the hope that it will be useful, but WITHOUT
+ ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+ FOR A PARTICULAR PURPOSE.  See the license for more details.
+*/
+
+/*! \file ratehelperwithcustompillar.hpp
+    \brief generic wrapper that overrides a RateHelper's pillar date,
+           and a concrete, SWIG/Python-friendly specialization for
+           OvernightIborBasisSwapRateHelper.
+*/
+
+#ifndef quantlib_ratehelper_with_custom_pillar_hpp
+#define quantlib_ratehelper_with_custom_pillar_hpp
+
+#include <ql/experimental/termstructures/basisswapratehelpers.hpp>
+#include <utility>
+
+namespace QuantLib {
+
+    //! Wraps any RateHelper-derived class, overriding only its pillar date.
+    /*! The wrapped instrument (schedule, cash flows, repricing) is left
+        completely unchanged: earliestDate(), latestDate(),
+        latestRelevantDate(), maturityDate() and impliedQuote() all behave
+        exactly as in the wrapped Helper -- the swap/deposit/etc. really
+        does run over its own natural dates. Only pillarDate() -- i.e.
+        where IterativeBootstrap places this instrument's node on the
+        curve being built (see ql/termstructures/iterativebootstrap.hpp,
+        "dates[i] = helper->pillarDate();") -- is overridden with an
+        explicit custom date.
+
+        This is the same mechanism QuantLib's own helpers use internally
+        for their optional Pillar::Choice::CustomDate constructor
+        argument; it is exposed here as a generic wrapper for helpers
+        (such as OvernightIborBasisSwapRateHelper) that do not expose
+        that option themselves.
+
+        \warning customPillarDate should be chosen consistently with the
+                 instrument's own earliestDate()/latestDate() range (in
+                 particular, it should not be needed as valid curve data
+                 *before* earliestDate() or the bootstrap may behave
+                 inconsistently); this is exactly the same caveat that
+                 applies to QuantLib's native CustomDate pillar choice.
+    */
+    template <class Helper>
+    class RateHelperWithCustomPillar : public Helper {
+      public:
+        template <class... Args>
+        RateHelperWithCustomPillar(const Date& customPillarDate, Args&&... args)
+        : Helper(std::forward<Args>(args)...), customPillarDate_(customPillarDate) {}
+
+        Date pillarDate() const override { return customPillarDate_; }
+
+      private:
+        Date customPillarDate_;
+    };
+
+    //! Concrete, non-template specialization for OvernightIborBasisSwapRateHelper
+    /*! Same constructor arguments as QuantLib::OvernightIborBasisSwapRateHelper,
+        with an extra leading \c customPillarDate: the Euribor (or other ibor)
+        rate implied by this basis-swap instrument is placed, on the curve
+        being bootstrapped, at this date -- instead of at the instrument's
+        actual maturity (spot + tenor) -- while the underlying basis swap
+        itself still runs over its real spot-to-spot+tenor schedule.
+
+        Concrete (rather than templated) so that it can be exposed to
+        Python via QuantLib-SWIG like any other RateHelper.
+    */
+    class OvernightIborBasisSwapRateHelperCustomPillar
+        : public RateHelperWithCustomPillar<OvernightIborBasisSwapRateHelper> {
+      public:

+
+/*! \file ratehelperwithcustompillar.hpp
+    \brief generic wrapper that overrides a RateHelper's pillar date,
+           and a concrete, SWIG/Python-friendly specialization for
+           OvernightIborBasisSwapRateHelper.
+*/
+
+#ifndef quantlib_ratehelper_with_custom_pillar_hpp
+#define quantlib_ratehelper_with_custom_pillar_hpp
+
+#include <ql/experimental/termstructures/basisswapratehelpers.hpp>
+#include <utility>
+
+namespace QuantLib {
+
+    //! Wraps any RateHelper-derived class, overriding only its pillar date.
+    /*! The wrapped instrument (schedule, cash flows, repricing) is left
+        completely unchanged: earliestDate(), latestDate(),
+        latestRelevantDate(), maturityDate() and impliedQuote() all behave
+        exactly as in the wrapped Helper -- the swap/deposit/etc. really
+        does run over its own natural dates. Only pillarDate() -- i.e.
+        where IterativeBootstrap places this instrument's node on the
+        curve being built (see ql/termstructures/iterativebootstrap.hpp,
+        "dates[i] = helper->pillarDate();") -- is overridden with an
+        explicit custom date.
+
+        This is the same mechanism QuantLib's own helpers use internally
+        for their optional Pillar::Choice::CustomDate constructor
+        argument; it is exposed here as a generic wrapper for helpers
+        (such as OvernightIborBasisSwapRateHelper) that do not expose
+        that option themselves.
+
+        \warning customPillarDate should be chosen consistently with the
+                 instrument's own earliestDate()/latestDate() range (in
+                 particular, it should not be needed as valid curve data
+                 *before* earliestDate() or the bootstrap may behave
+                 inconsistently); this is exactly the same caveat that
+                 applies to QuantLib's native CustomDate pillar choice.
+    */
+    template <class Helper>
+    class RateHelperWithCustomPillar : public Helper {
+      public:
+        template <class... Args>
+        RateHelperWithCustomPillar(const Date& customPillarDate, Args&&... args)
+        : Helper(std::forward<Args>(args)...), customPillarDate_(customPillarDate) {}
+
+        Date pillarDate() const override { return customPillarDate_; }
+
+      private:
+        Date customPillarDate_;
+    };
+
+    //! Concrete, non-template specialization for OvernightIborBasisSwapRateHelper
+    /*! Same constructor arguments as QuantLib::OvernightIborBasisSwapRateHelper,
+        with an extra leading \c customPillarDate: the Euribor (or other ibor)
+        rate implied by this basis-swap instrument is placed, on the curve
+        being bootstrapped, at this date -- instead of at the instrument's
+        actual maturity (spot + tenor) -- while the underlying basis swap
+        itself still runs over its real spot-to-spot+tenor schedule.
+
+        Concrete (rather than templated) so that it can be exposed to
+        Python via QuantLib-SWIG like any other RateHelper.
+    */
+    class OvernightIborBasisSwapRateHelperCustomPillar
+        : public RateHelperWithCustomPillar<OvernightIborBasisSwapRateHelper> {
+      public:
+        OvernightIborBasisSwapRateHelperCustomPillar(
+                const Date& customPillarDate,
+                const Handle<Quote>& basis,
+                const Period& tenor,
+                Natural settlementDays,
+                Calendar calendar,
+                BusinessDayConvention convention,
+                bool endOfMonth,
+                const ext::shared_ptr<OvernightIndex>& baseIndex,
+                const ext::shared_ptr<IborIndex>& otherIndex,
+                Handle<YieldTermStructure> discountHandle = Handle<YieldTermStructure>(),
+                bool bootstrapBaseCurve = false,
+                Integer paymentLag = 0,
+                std::optional<Frequency> overnightPaymentFrequency = std::nullopt,
+                std::optional<bool> useIndexedCoupons = std::nullopt,
+                DateGeneration::Rule rule = DateGeneration::Backward,
+                RateAveraging::Type averagingMethod = RateAveraging::Compound,
+                bool telescopicValueDates = false,
+                bool basisOnIborLeg = false)
+        : RateHelperWithCustomPillar<OvernightIborBasisSwapRateHelper>(
+              customPillarDate, basis, tenor, settlementDays, std::move(calendar), convention,
+              endOfMonth, baseIndex, otherIndex, std::move(discountHandle), bootstrapBaseCurve,
+              paymentLag, overnightPaymentFrequency, useIndexedCoupons, rule, averagingMethod,
+              telescopicValueDates, basisOnIborLeg) {}
+    };
+
+}
+
+#endif

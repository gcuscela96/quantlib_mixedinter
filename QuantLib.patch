diff --git a/ql/math/interpolations/frontierlinearrtcubicinterpolation.hpp b/ql/math/interpolations/frontierlinearrtcubicinterpolation.hpp
new file mode 100644
index 0000000..0309ef2
--- /dev/null
+++ b/ql/math/interpolations/frontierlinearrtcubicinterpolation.hpp
@@ -0,0 +1,366 @@
+/* -*- mode: c++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+
+/*
+ This file is part of a fork of QuantLib intended to add support for
+ curve bootstrapping with a "frontier" interpolation scheme: before a
+ given frontier time the curve is linear in r*t (equivalently: log-linear
+ on the discount factor), while from the frontier pillar onward it is a
+ natural cubic spline fitted only to the points at and after the
+ frontier pillar (earlier points never influence the spline).
+
+ QuantLib is free software: you can redistribute it and/or modify it
+ under the terms of the QuantLib license.  You should have received a
+ copy of the license along with this program; if not, please email
+ <quantlib-dev@lists.sf.net>. The license is also available online at
+ <https://www.quantlib.org/license.shtml>.
+
+ This program is distributed in the hope that it will be useful, but WITHOUT
+ ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+ FOR A PARTICULAR PURPOSE.  See the license for more details.
+*/
+
+/*! \file frontierlinearrtcubicinterpolation.hpp
+    \brief mixed interpolation for zero-rate curves: linear in r*t before a
+           frontier time, natural cubic spline in r from the frontier
+           pillar onward.
+*/
+
+#ifndef quantlib_frontier_linearrt_cubic_interpolation_hpp
+#define quantlib_frontier_linearrt_cubic_interpolation_hpp
+
+#include <ql/math/interpolations/linearinterpolation.hpp>
+#include <ql/math/interpolations/cubicinterpolation.hpp>
+#include <ql/utilities/dataformatters.hpp>
+#include <vector>
+
+namespace QuantLib {
+
+    namespace detail {
+        template <class I1, class I2> class FrontierLinearRtCubicInterpolationImpl;
+    }
+
+    //! Mixed linear-in-(r*t) / natural-cubic-in-r interpolation
+    /*! Designed to be applied to (time, zero-rate) pairs, as produced e.g.
+        by QuantLib::ZeroYield curve traits.
+
+        For x <= frontierTime, the interpolated value is
+            r(x) = L(x) / x
+        where L is the ordinary linear interpolation of the transformed
+        values y_i * x_i (i.e. r*t): this is exactly equivalent to a
+        log-linear interpolation of the discount factor exp(-r*t), the
+        market-standard "linear in r*t" convention.
+
+        For x > frontierTime, the interpolated value is given by a cubic
+        interpolation (by default a natural cubic spline, i.e. zero second
+        derivative at both ends) built using *only* the points from the
+        frontier pillar onwards: earlier points never influence the shape
+        of the spline. Because the frontier pillar itself is shared by
+        both pieces (it is simultaneously the last point of the linear
+        segment and the first point of the cubic segment), the resulting
+        curve is continuous (C^0) at the frontier, though not necessarily
+        differentiable there.
+
+        By default the cubic segment is fitted directly to the y values
+        (e.g. the zero rate itself). Passing \c cubicInRt = true instead
+        fits the cubic segment to the transformed values y_i * x_i (i.e.
+        r*t), mirroring the transform already used on the linear segment,
+        and divides back by x when evaluating: r(x) = C(x) / x for
+        x > frontierTime too.
+
+        \ingroup interpolations
+        \warning See the Interpolation class for information about the
+                 required lifetime of the underlying data.
+        \warning at least 3 points (including the frontier pillar) must
+                 be available at and after the frontier time for the
+                 cubic segment to be built; if not, construction throws
+                 (this is intentional: QuantLib::IterativeBootstrap
+                 catches the exception and falls back to plain Linear
+                 interpolation while the curve is being grown one pillar
+                 at a time, provided the Interpolator's `global` trait is
+                 set to `true` -- see FrontierLinearRtCubic below).
+    */
+    class FrontierLinearRtCubicInterpolation : public Interpolation {
+      public:
+        /*! \pre the \f$ x \f$ values must be sorted, and \f$ x_0 \f$
+                  should be (at or very close to) zero, consistently with
+                  a curve's reference-date pillar.
+            \param frontierTime the frontier time, in the same time
+                   metric (year fraction under the curve's day counter)
+                   used for the \f$ x \f$ values.
+        */
+        template <class I1, class I2>
+        FrontierLinearRtCubicInterpolation(
+                const I1& xBegin, const I1& xEnd, const I2& yBegin,
+                Time frontierTime,
+                CubicInterpolation::DerivativeApprox da = CubicInterpolation::Spline,
+                bool monotonic = false,
+                CubicInterpolation::BoundaryCondition leftC = CubicInterpolation::SecondDerivative,
+                Real leftConditionValue = 0.0,
+                CubicInterpolation::BoundaryCondition rightC = CubicInterpolation::SecondDerivative,
+                Real rightConditionValue = 0.0,
+                bool cubicInRt = false,
+                bool update = true) {
+            impl_ = ext::make_shared<detail::FrontierLinearRtCubicInterpolationImpl<I1, I2>>(
+                xBegin, xEnd, yBegin, frontierTime,
+                da, monotonic, leftC, leftConditionValue, rightC, rightConditionValue,
+                cubicInRt);
+            if (update)
+                impl_->update();
+        }
+    };
+
+    //! convenience class: natural cubic spline after the frontier
+    class FrontierLinearRtCubicNaturalSpline : public FrontierLinearRtCubicInterpolation {
+      public:
+        template <class I1, class I2>
+        FrontierLinearRtCubicNaturalSpline(const I1& xBegin, const I1& xEnd,
+                                            const I2& yBegin, Time frontierTime)
+        : FrontierLinearRtCubicInterpolation(xBegin, xEnd, yBegin, frontierTime,
+                                              CubicInterpolation::Spline, false,
+                                              CubicInterpolation::SecondDerivative, 0.0,
+                                              CubicInterpolation::SecondDerivative, 0.0) {}
+    };
+
+    //! interpolation factory and traits
+    /*! Usable as the Interpolator template parameter of
+        QuantLib::PiecewiseYieldCurve (typically with the ZeroYield
+        bootstrap traits).
+        \ingroup interpolations
+    */
+    class FrontierLinearRtCubic {
+      public:
+        // frontierTime defaults to 0.0 (i.e. the whole curve behaves as
+        // a plain cubic spline) purely so that this class stays
+        // default-constructible, as required by generic wrapper code
+        // (e.g. QuantLib-SWIG's PiecewiseYieldCurve bindings) that
+        // assumes every Interpolator has a default constructor. Pass an
+        // explicit frontierTime to actually use the mixed scheme.
+        explicit FrontierLinearRtCubic(
+                Time frontierTime = 0.0,
+                CubicInterpolation::DerivativeApprox da = CubicInterpolation::Spline,
+                bool monotonic = false,
+                CubicInterpolation::BoundaryCondition leftCondition = CubicInterpolation::SecondDerivative,
+                Real leftConditionValue = 0.0,
+                CubicInterpolation::BoundaryCondition rightCondition = CubicInterpolation::SecondDerivative,
+                Real rightConditionValue = 0.0,
+                bool cubicInRt = false)
+        : frontierTime_(frontierTime), da_(da), monotonic_(monotonic),
+          leftType_(leftCondition), rightType_(rightCondition),
+          leftValue_(leftConditionValue), rightValue_(rightConditionValue),
+          cubicInRt_(cubicInRt) {}
+
+        template <class I1, class I2>
+        Interpolation interpolate(const I1& xBegin, const I1& xEnd,
+                                   const I2& yBegin, bool update = true) const {
+            return FrontierLinearRtCubicInterpolation(
+                xBegin, xEnd, yBegin, frontierTime_,
+                da_, monotonic_, leftType_, leftValue_, rightType_, rightValue_,
+                cubicInRt_, update);
+        }
+
+        // Marked global=true on purpose: while the curve being bootstrapped
+        // has not yet grown past the frontier pillar (or does not yet have
+        // enough points after it), construction throws and
+        // QuantLib::IterativeBootstrap transparently falls back to plain
+        // Linear interpolation for that intermediate step -- this is the
+        // standard mechanism QuantLib already uses for Cubic/LogCubic/etc.
+        static const bool global = true;
+        static const Size requiredPoints = 2;
+
+      private:
+        Time frontierTime_;
+        CubicInterpolation::DerivativeApprox da_;
+        bool monotonic_;
+        CubicInterpolation::BoundaryCondition leftType_, rightType_;
+        Real leftValue_, rightValue_;
+        bool cubicInRt_;
+    };
+
+    //! convenience factory/trait: natural cubic spline after the frontier
+    /*! Thin wrapper around FrontierLinearRtCubic with the parameters fixed
+        to a plain (non-monotonic) natural cubic spline, i.e. zero second
+        derivative at the frontier pillar and at the last point, fitted
+        directly to the y values (e.g. the zero rate itself).
+    */
+    class FrontierLinearRtCubicNatural {
+      public:
+        explicit FrontierLinearRtCubicNatural(Time frontierTime = 0.0)
+        : base_(frontierTime, CubicInterpolation::Spline, false,
+                CubicInterpolation::SecondDerivative, 0.0,
+                CubicInterpolation::SecondDerivative, 0.0, false) {}
+
+        template <class I1, class I2>
+        Interpolation interpolate(const I1& xBegin, const I1& xEnd,
+                                   const I2& yBegin, bool update = true) const {
+            return base_.interpolate(xBegin, xEnd, yBegin, update);
+        }
+
+        static const bool global = true;
+        static const Size requiredPoints = 2;
+
+      private:
+        FrontierLinearRtCubic base_;
+    };
+
+    //! convenience factory/trait: natural cubic spline in r*t after the frontier
+    /*! Same as FrontierLinearRtCubicNatural, but the cubic segment is
+        fitted to the transformed values y_i * x_i (i.e. r*t) instead of
+        to y directly, and divided back by x when evaluated -- so the
+        whole curve (both before and after the frontier) is built as a
+        piecewise interpolation of r*t, only switching from linear to
+        natural cubic at the frontier pillar.
+    */
+    class FrontierLinearRtCubicNaturalRt {
+      public:
+        explicit FrontierLinearRtCubicNaturalRt(Time frontierTime = 0.0)
+        : base_(frontierTime, CubicInterpolation::Spline, false,
+                CubicInterpolation::SecondDerivative, 0.0,
+                CubicInterpolation::SecondDerivative, 0.0, true) {}
+
+        template <class I1, class I2>
+        Interpolation interpolate(const I1& xBegin, const I1& xEnd,
+                                   const I2& yBegin, bool update = true) const {
+            return base_.interpolate(xBegin, xEnd, yBegin, update);
+        }
+
+        static const bool global = true;
+        static const Size requiredPoints = 2;
+
+      private:
+        FrontierLinearRtCubic base_;
+    };
+
+    namespace detail {
+
+        template <class I1, class I2>
+        class FrontierLinearRtCubicInterpolationImpl final
+            : public Interpolation::templateImpl<I1, I2> {
+          public:
+            FrontierLinearRtCubicInterpolationImpl(
+                    const I1& xBegin, const I1& xEnd, const I2& yBegin,
+                    Time frontierTime,
+                    CubicInterpolation::DerivativeApprox da,
+                    bool monotonic,
+                    CubicInterpolation::BoundaryCondition leftC,
+                    Real leftConditionValue,
+                    CubicInterpolation::BoundaryCondition rightC,
+                    Real rightConditionValue,
+                    bool cubicInRt = false)
+            : Interpolation::templateImpl<I1, I2>(xBegin, xEnd, yBegin, 2),
+              frontierTime_(frontierTime),
+              da_(da), monotonic_(monotonic),
+              leftC_(leftC), rightC_(rightC),
+              leftValue_(leftConditionValue), rightValue_(rightConditionValue),
+              cubicInRt_(cubicInRt) {
+
+                Size size = static_cast<Size>(this->xEnd_ - this->xBegin_);
+
+                // n_ = index of the last point at or before the frontier
+                // time (the "frontier pillar"); always kept between 1 and
+                // size-2 so both segments retain at least one point of
+                // their own besides the shared frontier pillar.
+                n_ = 0;
+                while (n_ + 1 < size && this->xBegin_[n_] <= frontierTime_)
+                    ++n_;
+                if (n_ == 0)
+                    n_ = 1;
+
+                Size tailSize = size - n_;
+                QL_REQUIRE(tailSize >= 3,
+                           "FrontierLinearRtCubicInterpolation: not enough points "
+                           "at and after the frontier time (" << frontierTime_
+                           << ") to build the cubic segment: got " << tailSize
+                           << ", need at least 3 (the frontier pillar plus two more)");
+
+                rt_.resize(size);
+            }
+
+            void update() override {
+                Size size = static_cast<Size>(this->xEnd_ - this->xBegin_);
+                for (Size i = 0; i < size; ++i)
+                    rt_[i] = this->yBegin_[i] * this->xBegin_[i];
+
+                linear_ = LinearInterpolation(this->xBegin_, this->xBegin_ + n_ + 1, rt_.begin());
+                linear_.update();
+
+                if (cubicInRt_) {
+                    cubic_ = CubicInterpolation(this->xBegin_ + n_, this->xEnd_, rt_.begin() + n_,
+                                                da_, monotonic_,
+                                                leftC_, leftValue_, rightC_, rightValue_);
+                } else {
+                    cubic_ = CubicInterpolation(this->xBegin_ + n_, this->xEnd_, this->yBegin_ + n_,
+                                                da_, monotonic_,
+                                                leftC_, leftValue_, rightC_, rightValue_);
+                }
+                cubic_.update();
+
+                xFrontier_ = this->xBegin_[n_];
+            }
+
+            Real value(Real x) const override {
+                if (x <= xFrontier_) {
+                    if (x == 0.0)
+                        return this->yBegin_[0];
+                    return linear_(x, true) / x;
+                }
+                if (cubicInRt_)
+                    return cubic_(x, true) / x;
+                return cubic_(x, true);
+            }
+
+            Real derivative(Real x) const override {
+                if (x <= xFrontier_) {
+                    Real xx = (x == 0.0 ? QL_EPSILON : x);
+                    Real L = linear_(xx, true);
+                    Real Lp = linear_.derivative(xx, true);
+                    return (Lp * xx - L) / (xx * xx);
+                }
+                if (cubicInRt_) {
+                    Real C = cubic_(x, true);
+                    Real Cp = cubic_.derivative(x, true);
+                    return (Cp * x - C) / (x * x);
+                }
+                return cubic_.derivative(x, true);
+            }
+
+            Real secondDerivative(Real x) const override {
+                if (x <= xFrontier_) {
+                    Real xx = (x == 0.0 ? QL_EPSILON : x);
+                    // r(x) = L(x)/x, L linear (L'' == 0 a.e.)
+                    Real L = linear_(xx, true);
+                    Real Lp = linear_.derivative(xx, true);
+                    return (2.0 * L) / (xx * xx * xx) - (2.0 * Lp) / (xx * xx);
+                }
+                if (cubicInRt_) {
+                    // r(x) = C(x)/x, C cubic (C'' generally nonzero)
+                    Real C = cubic_(x, true);
+                    Real Cp = cubic_.derivative(x, true);
+                    Real Cpp = cubic_.secondDerivative(x, true);
+                    return Cpp / x - 2.0 * Cp / (x * x) + 2.0 * C / (x * x * x);
+                }
+                return cubic_.secondDerivative(x, true);
+            }
+
+            Real primitive(Real) const override {
+                QL_FAIL("FrontierLinearRtCubicInterpolation primitive not implemented");
+            }
+
+          private:
+            Time frontierTime_;
+            CubicInterpolation::DerivativeApprox da_;
+            bool monotonic_;
+            CubicInterpolation::BoundaryCondition leftC_, rightC_;
+            Real leftValue_, rightValue_;
+            bool cubicInRt_;
+            Size n_;
+            Real xFrontier_ = 0.0;
+            std::vector<Real> rt_;
+            Interpolation linear_;
+            Interpolation cubic_;
+        };
+
+    }
+
+}
+
+#endif

+/* -*- mode: c++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+
+/*
+ This file is part of a fork of QuantLib intended to add support for
+ bootstrapping a forwarding curve as an additive zero-rate spread on top
+ of a backbone (discounting) curve, e.g. a Euribor forwarding curve built
+ as "ESTR zero rate (interpolated) + spread zero rate", with the spread
+ itself bootstrapped using the "frontier" linear/cubic mixed scheme
+ already used elsewhere in this fork.
+
+ QuantLib is free software: you can redistribute it and/or modify it
+ under the terms of the QuantLib license.  You should have received a
+ copy of the license along with this program; if not, please email
+ <quantlib-dev@lists.sf.net>. The license is also available online at
+ <https://www.quantlib.org/license.shtml>.
+
+ This program is distributed in the hope that it will be useful, but WITHOUT
+ ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+ FOR A PARTICULAR PURPOSE.  See the license for more details.
+*/
+
+/*! \file piecewisefrontiermixedrtzerospreaded.hpp
+    \brief piecewise zero-spread curve (frontier linear/cubic-in-r*t mixed
+           interpolation) on top of a backbone discounting/forecasting curve
+*/
+
+#ifndef quantlib_piecewise_frontier_mixed_rt_zero_spreaded_hpp
+#define quantlib_piecewise_frontier_mixed_rt_zero_spreaded_hpp
+
+#include <ql/termstructures/yield/piecewiseyieldcurve.hpp>
+#include <ql/math/interpolations/frontierlinearrtcubicinterpolation.hpp>
+#include <cmath>
+#include <algorithm>
+#include <utility>
+
+namespace QuantLib {
+
+    //! Zero-rate-SPREAD curve traits
+    /*! Identical to the stock QuantLib::ZeroYield traits, except for the
+        bootstrap guess used for pillars beyond the first one.
+
+        QuantLib::ZeroYield::guess() extrapolates a starting guess for a new
+        pillar by calling <tt>c->zeroRate(d, dayCounter, Continuous, Annual,
+        true)</tt> on the curve being built. For a plain absolute-rate curve
+        this is a sensible flat-forward extrapolation of the curve's own
+        data. For PiecewiseFrontierMixedRtZeroSpreaded, however,
+        <tt>zeroRate()</tt> (like any other public YieldTermStructure
+        accessor) goes through the curve's *overridden* discountImpl(),
+        which returns the backbone-plus-spread TOTAL rate -- using that as
+        a guess for the SPREAD unknown would be wrong by orders of
+        magnitude (e.g. guessing ~3% for a ~10bp spread), and in practice
+        corrupts later global re-fits of the frontier cubic segment enough
+        to break root bracketing on earlier pillars.
+
+        SpreadedZeroYield::guess() instead falls back to the previous
+        pillar's already-bootstrapped spread value (a flat guess), reading
+        it directly from the curve's raw data array -- never through the
+        polymorphic zeroRate()/discount() chain -- so it stays correct
+        regardless of what discountImpl() has been overridden to do.
+    */
+    struct SpreadedZeroYield {
+        template <class Interpolator>
+        struct curve {
+            typedef InterpolatedZeroCurve<Interpolator> type;
+        };
+        typedef BootstrapHelper<YieldTermStructure> helper;
+
+        static Date initialDate(const YieldTermStructure* c) {
+            return c->referenceDate();
+        }
+        // dummy value at reference date (irrelevant: multiplied by t=0)
+        static Real initialValue(const YieldTermStructure*) {
+            return 0.0;
+        }
+
+        template <class C>
+        static Real guess(Size i, const C* c, bool validData, Size) {
+            if (validData) // previous iteration value
+                return c->data()[i];
+
+            if (i == 1) // first pillar: no prior spread data to extrapolate from
+                return 0.0;
+
+            // flat guess: reuse the previous *spread* node directly (never
+            // through zeroRate()/discountImpl(), which would return the
+            // backbone+spread total on this curve type)
+            return c->data()[i - 1];
+        }
+
+        template <class C>
+        static std::pair<Array, bool> globalGuess(const C* c, bool validData) {
+            if (validData)
+                return {Array(c->data().begin() + 1, c->data().end()), true};
+            return {Array(c->times().size() - 1, 0.0), true};
+        }
+
+        template <class C>
+        static Real minValueAfter(Size, const C* c, bool validData, Size) {
+            if (validData) {
+                Real r = *(std::min_element(c->data().begin(), c->data().end()));
+                return r < 0.0 ? Real(r * 2.0) : Real(r / 2.0);
+            }
+            return -1.0;
+        }
+        template <class C>
+        static Real maxValueAfter(Size, const C* c, bool validData, Size) {
+            if (validData) {
+                Real r = *(std::max_element(c->data().begin(), c->data().end()));
+                return r < 0.0 ? Real(r / 2.0) : Real(r * 2.0);
+            }
+            return 1.0;
+        }
+
+        static void updateGuess(std::vector<Real>& data, Real rate, Size i) {
+            data[i] = rate;
+            if (i == 1)
+                data[0] = rate;
+        }
+        static Size maxIterations() { return 100; }
+    };
+
+    //! Piecewise zero-rate-spread term structure on top of a backbone curve
+    /*! Bootstraps a zero-rate spread s(t) -- using the same "frontier"
+        linear-in-(s*t) / natural-cubic-in-(s*t) mixed interpolation scheme
+        already used by PiecewiseFrontierMixedRtZero -- such that the
+        resulting discount factor is
+
+            df(t) = backbone->discount(t) * exp(-s(t) * t)
+
+        i.e. the exposed curve's zero rate is always the backbone's zero
+        rate (as given by the backbone curve's own interpolation) plus the
+        bootstrapped spread s(t). This is the standard "forwarding curve
+        bootstrapped as a spread over a discounting backbone" construction
+        (e.g. a Euribor curve built as ESTR + spread), as opposed to
+        bootstrapping the forwarding curve's absolute zero rate directly.
+
+        The rate helpers passed to this curve must have their forecasting
+        curve handle relinked to *this* curve (the usual QuantLib
+        self-referencing bootstrap pattern: the handle is relinked
+        automatically to the object under construction), exactly as for
+        any other PiecewiseYieldCurve -- nothing in the helper code needs
+        to change: this class is a drop-in replacement wherever a plain
+        PiecewiseYieldCurve<ZeroYield, Interpolator> was used as the
+        forecasting curve, transparently combining the backbone and the
+        bootstrapped spread behind the same Handle<YieldTermStructure>
+        interface.
+
+        \warning With very few pillars and a large gap in maturity between
+                 an early-payment stub (customPaymentDate before the real
+                 accrual end) and the next pillar, the natural cubic
+                 segment of the frontier interpolation can reshape sharply
+                 enough, as the stub's own node is perturbed during the
+                 root search, to break root bracketing for that stub
+                 ("root not bracketed" with both endpoints on the same
+                 side of zero). This is a property of fitting a natural
+                 cubic spline to widely and unevenly spaced points, not
+                 specific to the backbone composition; it disappears once
+                 the curve has a reasonably dense, evenly spaced set of
+                 pillars (as a real multi-instrument curve normally does).
+                 If it is hit in practice, add an intermediate pillar near
+                 the stub, or use \c FrontierLinearRtCubic with a higher
+                 \c frontierTime so the problematic region stays in the
+                 (always well-behaved) linear segment.
+
+        \note The day counter of this curve and the backbone's may differ.
+              The backbone is always queried by calendar date (through
+              the integer days surrounding this curve's time t, with
+              log-linear interpolation in between), so it applies its
+              own day counter and reference date. When both day counters
+              and reference dates coincide, a direct time-based query is
+              used instead.
+
+        \ingroup yieldtermstructures
+    */
+    class PiecewiseFrontierMixedRtZeroSpreaded
+        : public PiecewiseYieldCurve<SpreadedZeroYield, FrontierLinearRtCubicNaturalRt> {
+      private:
+        typedef PiecewiseYieldCurve<SpreadedZeroYield, FrontierLinearRtCubicNaturalRt> base_t;
+      public:
+        //! \name Constructors
+        //@{
+        PiecewiseFrontierMixedRtZeroSpreaded(
+                const Date& referenceDate,
+                std::vector<ext::shared_ptr<BootstrapHelper<YieldTermStructure> > > instruments,
+                const DayCounter& dayCounter,
+                Handle<YieldTermStructure> backbone,
+                Time frontierTime,
+                const std::vector<Handle<Quote> >& jumps = {},
+                const std::vector<Date>& jumpDates = {},
+                base_t::bootstrap_type bootstrap = {})
+        : base_t(referenceDate, std::move(instruments), dayCounter, jumps, jumpDates,
+                 FrontierLinearRtCubicNaturalRt(frontierTime), std::move(bootstrap)),
+          backbone_(std::move(backbone)) {
+            checkBackbone();
+            registerWith(backbone_);
+        }
+
+        PiecewiseFrontierMixedRtZeroSpreaded(
+                Natural settlementDays,
+                const Calendar& calendar,
+                std::vector<ext::shared_ptr<BootstrapHelper<YieldTermStructure> > > instruments,
+                const DayCounter& dayCounter,
+                Handle<YieldTermStructure> backbone,
+                Time frontierTime,
+                const std::vector<Handle<Quote> >& jumps = {},
+                const std::vector<Date>& jumpDates = {},
+                base_t::bootstrap_type bootstrap = {})
+        : base_t(settlementDays, calendar, std::move(instruments), dayCounter,
+                 jumps, jumpDates, FrontierLinearRtCubicNaturalRt(frontierTime),
+                 std::move(bootstrap)),
+          backbone_(std::move(backbone)) {
+            checkBackbone();
+            registerWith(backbone_);
+        }
+        //@}
+
+        //! the backbone (discounting/forecasting) curve the spread is built on
+        const Handle<YieldTermStructure>& backboneCurve() const { return backbone_; }
+
+      protected:
+        DiscountFactor discountImpl(Time t) const override {
+            // trigger the lazy bootstrap of the spread nodes, exactly as
+            // PiecewiseYieldCurve<...>::discountImpl() would; we cannot
+            // call that method directly since it is private in the base,
+            // so we replicate it: calculate(), then read the *spread's*
+            // discount factor via the inherited ZeroYieldStructure
+            // implementation (which uses this curve's own interpolated
+            // data, i.e. the bootstrapped spread, not an absolute rate).
+            calculate();
+            DiscountFactor spreadDf = this->ZeroYieldStructure::discountImpl(t);
+            return backboneDiscount(t) * spreadDf;
+        }
+
+      private:
+        //! backbone discount factor at the calendar point corresponding
+        //! to this curve's time t
+        /*! The two curves may use different day counters, so the raw
+            time t cannot be passed to the backbone as is. t always comes
+            from a date (via this curve's day counter and reference
+            date); we recover the surrounding integer days, query the
+            backbone by Date (so that it applies its own day counter),
+            and interpolate log-linearly between the two days so the
+            result stays smooth for queries that do not fall on a date.
+        */
+        DiscountFactor backboneDiscount(Time t) const {
+            if (t <= 0.0)
+                return backbone_->discount(0.0);
+            const DayCounter& dc = this->dayCounter();
+            if (dc == backbone_->dayCounter() &&
+                this->referenceDate() == backbone_->referenceDate())
+                return backbone_->discount(t); // same time metric: direct
+            Date ref = this->referenceDate();
+            // initial guess for the day count, then walk to the bracket
+            // (year fraction is non-decreasing in the date)
+            Time perYear = dc.yearFraction(ref, ref + 365);
+            QL_REQUIRE(perYear > 0.0, "invalid day counter year fraction");
+            Integer n = std::max<Integer>(0, static_cast<Integer>(std::lround(t * 365.0 / perYear)));
+            while (n > 0 && dc.yearFraction(ref, ref + n) > t)
+                --n;
+            while (dc.yearFraction(ref, ref + (n + 1)) <= t)
+                ++n;
+            Date d0 = ref + n, d1 = ref + (n + 1);
+            Time t0 = dc.yearFraction(ref, d0), t1 = dc.yearFraction(ref, d1);
+            Real w = (t1 > t0) ? (t - t0) / (t1 - t0) : 0.0;
+            Real ln0 = std::log(backbone_->discount(d0));
+            Real ln1 = std::log(backbone_->discount(d1));
+            return std::exp((1.0 - w) * ln0 + w * ln1);
+        }
+
+        void checkBackbone() const {
+            QL_REQUIRE(!backbone_.empty(),
+                       "PiecewiseFrontierMixedRtZeroSpreaded: empty backbone curve handle");
+        }
+
+        Handle<YieldTermStructure> backbone_;
+    };
+
+}
+
+#endif

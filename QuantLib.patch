@@ -0,0 +1,109 @@
+/* -*- mode: c++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+
+/*
+ This file is part of a fork of QuantLib intended to add support for
+ "early payment" coupons: a coupon whose accrual/fixing period is
+ unchanged but whose cash flow is paid (and discounted) on a date
+ earlier than its natural accrual end date.
+
+ QuantLib is free software: you can redistribute it and/or modify it
+ under the terms of the QuantLib license.  You should have received a
+ copy of the license along with this program; if not, please email
+ <quantlib-dev@lists.sf.net>. The license is also available online at
+ <https://www.quantlib.org/license.shtml>.
+
+ This program is distributed in the hope that it will be useful, but WITHOUT
+ ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+ FOR A PARTICULAR PURPOSE.  See the license for more details.
+*/
+
+/*! \file earlypaymentcoupon.hpp
+    \brief coupon wrapper that redates an existing coupon's cash flow to
+           an earlier payment date, without touching its accrual/fixing
+*/
+
+#ifndef quantlib_early_payment_coupon_hpp
+#define quantlib_early_payment_coupon_hpp
+
+#include <ql/cashflows/coupon.hpp>
+#include <utility>
+
+namespace QuantLib {
+
+    //! Coupon that pays an existing coupon's cash flow on an earlier date
+    /*! Several concrete coupon classes (notably OvernightIndexedCoupon)
+        structurally enforce \c paymentDate \>= \c accrualEndDate in their
+        constructor, because in the ordinary case a coupon cannot be paid
+        before the period it accrues over has ended. Some real-world
+        instruments do need exactly that, though: the accrual/fixing
+        period genuinely runs to its natural end date, but the cash flow
+        is contractually paid earlier (e.g. a swap leg whose payment is
+        pulled forward to an ECB/IMM date to avoid overlapping with the
+        next leg on a curve, while the rate itself still fixes/compounds
+        over the full real period).
+
+        EarlyPaymentCoupon represents this by wrapping an already-built,
+        fully valid "natural" coupon (whose own paymentDate equals its
+        accrualEndDate, so every invariant of the wrapped class is
+        satisfied) and overriding only the *cash-flow date* used for
+        discounting/NPV/BPS purposes -- amount(), rate(), dayCounter(),
+        accruedAmount() and every accrual-related inspector (nominal(),
+        accrualStartDate(), accrualEndDate(), accrualPeriod(), ...,
+        inherited unchanged from the Coupon base) are computed exactly as
+        for the wrapped coupon, since the payment date does not enter
+        into any of those calculations for a standard floating coupon.
+    */
+    class EarlyPaymentCoupon : public Coupon {
+      public:
+        EarlyPaymentCoupon(const Date& paymentDate,
+                            ext::shared_ptr<Coupon> underlyingCoupon)
+        : Coupon(paymentDate, underlyingCoupon->nominal(),
+                 underlyingCoupon->accrualStartDate(), underlyingCoupon->accrualEndDate(),
+                 underlyingCoupon->referencePeriodStart(), underlyingCoupon->referencePeriodEnd(),
+                 underlyingCoupon->exCouponDate()),
+          underlyingCoupon_(std::move(underlyingCoupon)) {
+            registerWith(underlyingCoupon_);
+        }
+
+        //! \name CashFlow interface
+        //@{
+        Real amount() const override { return underlyingCoupon_->amount(); }
+        //@}
+        //! \name Coupon interface
+        //@{
+        Rate rate() const override { return underlyingCoupon_->rate(); }
+        DayCounter dayCounter() const override { return underlyingCoupon_->dayCounter(); }
+        Real accruedAmount(const Date& d) const override {
+            return underlyingCoupon_->accruedAmount(d);
+        }
+        //@}
+        //! \name Observer interface
+        //@{
+        /*! Forwards to the wrapped coupon's own deepUpdate(). This matters
+            during bootstrapping: Swap::deepUpdate() (called by
+            impliedQuote() before every NPV() re-evaluation) invalidates a
+            leg by calling deepUpdate() on each of its cash flows; without
+            this override the wrapped (naturally-dated) coupon's own cached
+            rate would never be invalidated, since nothing else in the leg
+            still points to it directly. registerWith(underlyingCoupon_) in
+            the constructor already handles ordinary Observer notifications
+            (e.g. a quote or curve changing outside of a bootstrap loop);
+            this override only adds the deepUpdate() forwarding that
+            Observer's default (shallow) implementation does not provide.
+        */
+        void deepUpdate() override {
+            underlyingCoupon_->deepUpdate();
+            update();
+        }
+        //@}
+
+        //! the wrapped, naturally-dated coupon this cash flow is redated from
+        const ext::shared_ptr<Coupon>& underlyingCoupon() const { return underlyingCoupon_; }
+
+      private:
+        ext::shared_ptr<Coupon> underlyingCoupon_;
+    };
+
+}
+
+#endif

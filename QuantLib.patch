+/* -*- mode: c++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+
+/*
+ This file is part of a fork of QuantLib intended to add support for
+ "flat rate" coupons: a coupon that pays rate() * nominal() with no
+ accrual-period (day count fraction) scaling at all.
+
+ QuantLib is free software: you can redistribute it and/or modify it
+ under the terms of the QuantLib license.  You should have received a
+ copy of the license along with this program; if not, please email
+ <quantlib-dev@lists.sf.net>. The license is also available online at
+ <https://www.quantlib.org/license.shtml>.
+
+ This program is distributed in the hope that it will be useful, but WITHOUT
+ ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+ FOR A PARTICULAR PURPOSE.  See the license for more details.
+*/
+
+/*! \file flatratecoupon.hpp
+    \brief coupon wrapper that pays rate()*nominal() with no day-count
+           accrual-period scaling at all
+*/
+
+#ifndef quantlib_flat_rate_coupon_hpp
+#define quantlib_flat_rate_coupon_hpp
+
+#include <ql/cashflows/coupon.hpp>
+#include <utility>
+
+namespace QuantLib {
+
+    //! Coupon that pays rate() * nominal(), skipping accrual-period scaling
+    /*! Wraps an already-built, fully valid "normal" coupon (whose own
+        amount() is rate()*accrualPeriod()*nominal(), as usual for a
+        floating coupon) and reports instead a flat amount equal to
+        rate()*nominal(), with no day-count accrual fraction applied at
+        all. Every other inspector (nominal(), accrualStartDate(),
+        accrualEndDate(), rate(), dayCounter(), ...) is delegated
+        unchanged to the wrapped coupon, so accrual/fixing metadata stays
+        meaningful for introspection even though it does not enter the
+        cash flow amount.
+
+        \warning Coupon::accrualPeriod() is declared non-virtual in
+                 QuantLib, so it cannot be overridden here: any code that
+                 computes a basis-point sensitivity via
+                 CashFlows::bps()/Swap::legBPS() (which multiplies by
+                 accrualPeriod()) will therefore NOT reflect this
+                 coupon's flat amount definition -- it would still use
+                 the wrapped coupon's real accrual period. Callers that
+                 need a BPS/implied-quote consistent with "no day count"
+                 for a leg wrapped this way (such as
+                 OvernightIborBasisSwapRateHelperForwardStarting, when
+                 the spread-bearing leg uses flat-rate payment) must
+                 compute that sensitivity directly instead of going
+                 through legBPS() for that leg.
+    */
+    class FlatRateCoupon : public Coupon {
+      public:
+        explicit FlatRateCoupon(ext::shared_ptr<Coupon> underlyingCoupon)
+        : Coupon(underlyingCoupon->date(), underlyingCoupon->nominal(),
+                 underlyingCoupon->accrualStartDate(), underlyingCoupon->accrualEndDate(),
+                 underlyingCoupon->referencePeriodStart(), underlyingCoupon->referencePeriodEnd(),
+                 underlyingCoupon->exCouponDate()),
+          underlyingCoupon_(std::move(underlyingCoupon)) {
+            registerWith(underlyingCoupon_);
+        }
+
+        //! \name CashFlow interface
+        //@{
+        Real amount() const override { return underlyingCoupon_->rate() * nominal(); }
+        //@}
+        //! \name Coupon interface
+        //@{
+        Rate rate() const override { return underlyingCoupon_->rate(); }
+        DayCounter dayCounter() const override { return underlyingCoupon_->dayCounter(); }
+        Real accruedAmount(const Date& d) const override {
+            // no accrual-period scaling: pay the full flat amount once the
+            // period has started, nothing before it
+            return (d <= accrualStartDate()) ? 0.0 : amount();
+        }
+        //@}
+        //! \name Observer interface
+        //@{
+        //! forwards to the wrapped coupon's own deepUpdate() -- see
+        //! EarlyPaymentCoupon::deepUpdate() for why this matters during
+        //! bootstrapping
+        void deepUpdate() override {
+            underlyingCoupon_->deepUpdate();
+            update();
+        }
+        //@}
+
+        //! the wrapped coupon this flat cash flow is computed from
+        const ext::shared_ptr<Coupon>& underlyingCoupon() const { return underlyingCoupon_; }
+
+      private:
+        ext::shared_ptr<Coupon> underlyingCoupon_;
+    };
+
+}
+
+#endif
